# Copy to .env and fill in. .env is gitignored - never commit real tokens.

# One entry per probe: "name:token,name2:token2". Generate a token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_PROBE_TOKENS=macbook:REPLACE_ME

# Only needed when running behind a reverse proxy that injects this header
# after its own auth gate (e.g. Traefik forward-auth via Authentik) - proves
# the request actually came through the proxy, not directly from some other
# local process. Leave unset for local dev (check is skipped when empty).
NETMON_PROXY_SECRET=

# Push notifications via ntfy.sh - https://ntfy.sh/<topic>. Empty disables
# alerting entirely. See hub/app/alerts.py for what triggers a push.
NTFY_URL=
ALERT_INTERVAL_SEC=300
ALERT_COOLDOWN_SEC=3600
PROBE_STALE_MINUTES=10
LOSS_ALERT_PCT=10

# How long to keep raw samples before they're pruned (180 = ~6 months).
RETENTION_DAYS=180
RETENTION_INTERVAL_SEC=86400
