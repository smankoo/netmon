# netmon MCP server config. Copy to .env (gitignored) and adjust.
# Every value here has a default in netmon_mcp/config.py - an empty .env works.

# --- how to reach the hub ---------------------------------------------------
# ssh  : run curl on the VPS over ssh (default). The proxy secret stays on the
#        VPS; this machine's only credential is its ssh key.
# http : talk to the hub directly. Only from somewhere that can reach the port,
#        i.e. on the VPS itself. Needs NETMON_PROXY_SECRET below.
NETMON_ACCESS=ssh

# ssh mode
NETMON_SSH_TARGET=deploy@vps.taild6699c.ts.net
NETMON_SSH_HUB_URL=http://127.0.0.1:8000
# The hub's own env file on the VPS - the remote side reads the secret from here.
NETMON_SSH_ENV_FILE=/opt/netmon-hub/.env
#NETMON_SSH_CONNECT_TIMEOUT=10
#NETMON_SSH_TIMEOUT=60
#NETMON_REMOTE_CURL_TIMEOUT=25

# http mode only. Every endpoint except /api/ingest and /healthz requires this
# header; on the pretty hostname the read API additionally sits behind
# Authentik SSO, so a headless client cannot use it.
#NETMON_HUB_URL=http://127.0.0.1:8000
#NETMON_PROXY_SECRET=
#NETMON_PROXY_SECRET_HEADER=X-Netmon-Proxy-Secret

# --- analysis thresholds (netmon_incident_report) ---------------------------
# The provisioned plan. Deliberately unset by default: a guessed number would
# end up quoted at the ISP. Set both to get plan-compliance figures.
#NETMON_PLAN_DOWN_MBPS=1000
#NETMON_PLAN_UP_MBPS=50

#NETMON_LATENCY_HIGH_MS=100
#NETMON_MIN_PLAUSIBLE_RTT_MS=3      # below this, ICMP is being answered locally
#NETMON_LOSS_WINDOW_MINUTES=15      # mirrors the hub's own loss alert rule
#NETMON_LOSS_WINDOW_MIN_SAMPLES=3
#NETMON_LOSS_ALERT_PCT=10
#NETMON_LOSS_BACKGROUND_PCT=1
#NETMON_SNR_MIN_DB=35               # QAM256 comfort floor
#NETMON_DS_SIGNAL_MIN_DBMV=-15      # downstream spec window
#NETMON_DS_SIGNAL_MAX_DBMV=15
#NETMON_DS_SIGNAL_MARGINAL_DBMV=10  # in spec but not comfortable
#NETMON_US_SIGNAL_MIN_DBMV=35       # upstream spec window
#NETMON_US_SIGNAL_MAX_DBMV=52
#NETMON_BUFFERBLOAT_MS=100
#NETMON_PING_INTERVAL_SEC=60        # must match the probe's PING_INTERVAL_SEC
#NETMON_GAP_FACTOR=3
#NETMON_TZ=America/Toronto
