# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
# Any interval set to 0 disables that collector entirely. Prefer that to blanking
# a collector's credentials: the modem collector with no credentials does not go
# quiet, it reports an error row every interval. With more than one probe, see
# "Splitting collectors across probes" in the README before copying this file -
# some collectors must not run on two probes at once.
#
# *_PHASE_OFFSET_SEC staggers a collector against the same collector on another
# probe. Offsets are anchored to the epoch, not to process start, so they survive
# restarts. Use half an interval for two probes (0 and 900 on a 1800s speedtest).

PING_TARGETS=1.1.1.1,8.8.8.8
PING_INTERVAL_SEC=60
PING_PHASE_OFFSET_SEC=0
PING_COUNT=4

SPEEDTEST_INTERVAL_SEC=1800
SPEEDTEST_PHASE_OFFSET_SEC=0
BUFFERBLOAT_PING_TARGET=1.1.1.1

MODEM_HOST=192.168.0.1
MODEM_USER=cusadmin
MODEM_PASS=

MODEM_POLL_INTERVAL_SEC=900
MODEM_PHASE_OFFSET_SEC=0

# Comma-separated. Any URL whose availability you care about, e.g. an
# IPTV portal's middleware endpoint.
HTTP_CHECK_URLS=https://example.com
HTTP_CHECK_INTERVAL_SEC=60
HTTP_CHECK_PHASE_OFFSET_SEC=0
HTTP_CHECK_TIMEOUT_SEC=10

# Where this probe reports to, and this probe's own token (the hub maps this
# token to a probe name server-side - see hub/.env's HUB_PROBE_TOKENS).
HUB_URL=https://netmon.example.com
HUB_TOKEN=
SEND_INTERVAL_SEC=30
